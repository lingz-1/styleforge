# PostgreSQL 连接 DSN（SQLite 已退役）
STYLEFORGE_DATABASE_DSN=postgresql://styleforge:PASSWORD@127.0.0.1:5432/styleforge
STYLEFORGE_TEST_DATABASE_DSN=postgresql://styleforge:PASSWORD@127.0.0.1:5432/styleforge_test
STYLEFORGE_ARTIFACT_ROOT=C:\Users\32369\Desktop\agent-p\style\artifacts
STYLEFORGE_API_URL=http://127.0.0.1:8000

# Redis 会话状态缓存（可选）。启用后同会话二次请求命中缓存。
# STYLEFORGE_REDIS_ENABLED=false
# STYLEFORGE_REDIS_URL=redis://127.0.0.1:6379/0
# STYLEFORGE_REDIS_TTL=86400

# LLM 语义 Agent（可选）。不配置则使用确定性回退链路。
# STYLEFORGE_LLM_ENABLED=false
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT=60
# DEEPSEEK_MAX_RETRIES=2

# 联网搜索（agentic search_web 工具，可选）。不配置 key 则工具优雅降级，
# Agent 主链不受影响。TAVILY_API_KEY 在 https://app.tavily.com 申请。
# STYLEFORGE_WEB_SEARCH_ENABLED=true
# STYLEFORGE_WEB_SEARCH_TIMEOUT=10
# STYLEFORGE_WEB_SEARCH_MAX_RESULTS=5
# TAVILY_API_KEY=

# MCP：默认通过当前 style Python 环境以 stdio 启动官方 Time/Fetch Server。
# 若填写 URL，则对应服务切换为远程 Streamable HTTP。
# STYLEFORGE_MCP_ENABLED=true
# STYLEFORGE_MCP_WEATHER_ENABLED=true
# STYLEFORGE_MCP_TIMEOUT=20
# STYLEFORGE_MCP_TIME_URL=
# STYLEFORGE_MCP_FETCH_URL=
# STYLEFORGE_MCP_FETCH_ALLOWED_HOSTS=api.open-meteo.com,geocoding-api.open-meteo.com
