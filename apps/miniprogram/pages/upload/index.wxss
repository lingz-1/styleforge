.upload-box {
  height: 320rpx;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.preview {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
}

.upload-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.plus {
  font-size: 64rpx;
  line-height: 1.2;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child { border-bottom: none; }

.label {
  width: 120rpx;
  color: #555;
}

.input {
  flex: 1;
}

.picker {
  color: #409eff;
}
