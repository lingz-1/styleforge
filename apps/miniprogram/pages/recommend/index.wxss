.input {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.intro { padding: 32rpx 8rpx 12rpx; }
.eyebrow { color: #a86138; font-size: 20rpx; letter-spacing: 5rpx; font-weight: 700; }
.title { margin-top: 12rpx; font-family: serif; font-size: 48rpx; line-height: 1.15; }
.lead { margin-top: 14rpx; color: #6e7973; line-height: 1.6; }
.prompt-card { box-shadow: 12rpx 12rpx 0 #e1e5df; }
.examples { white-space: nowrap; margin-bottom: 20rpx; }
.example { display: inline-block; margin-right: 10rpx; padding: 8rpx 16rpx; border: 1rpx solid #cbd1cc; border-radius: 999rpx; font-size: 22rpx; }
.result-head { border-bottom: 4rpx solid #18201d; }
.task-chip { color: #a86138; font-size: 22rpx; font-weight: 700; }
.result-title { margin-top: 10rpx; font-family: serif; font-size: 38rpx; }
.status { margin-top: 8rpx; color: #7c8580; font-size: 22rpx; }
.agent-rail { margin: 22rpx 0; border: 1rpx solid #d7ddd8; background: #fff; }
.agent-step { display: grid; grid-template-columns: 56rpx 1fr auto; align-items: center; gap: 10rpx; padding: 22rpx; border-bottom: 1rpx solid #d7ddd8; }
.agent-step:last-child { border-bottom: 0; }.agent-index { color: #a86138; font-family: serif; font-size: 30rpx; }.agent-status { color: #52675b; font-size: 22rpx; }
.warning { color: #8a551e; background: #fff4df; }.summary { color: #53605a; line-height: 1.75; }.metrics { display: flex; justify-content: space-between; margin-top: 18rpx; font-weight: 600; }
.item-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }.item-img { width: 100%; height: 180rpx; }.item-name { margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 22rpx; }.muted { color: #8a928e; font-size: 20rpx; }
.gap { margin-top: 14rpx; padding: 16rpx; border-top: 4rpx solid #a86138; background: #f4f2eb; }.gap text { display: block; margin-top: 6rpx; color: #66716b; }.gap .priority { color: #a86138; font-size: 18rpx; text-transform: uppercase; }.trace { height: 420rpx; font-size: 20rpx; white-space: pre-wrap; }

.section-title {
  font-weight: 600;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
}

.kv {
  color: #888;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.val {
  text-align: right;
}

.outfit-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.outfit-img {
  width: calc(50% - 8rpx);
  height: 220rpx;
  border-radius: 8rpx;
}

.reason {
  font-size: 24rpx;
  color: #555;
  padding: 4rpx 0;
}
