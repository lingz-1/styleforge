<view class="container">
  <view class="card">
    <textarea
      value="{{request}}"
      bindinput="onInput"
      placeholder="今天想怎么穿？"
      maxlength="500"
      auto-height
      class="input"
    />
    <view class="btn-primary" bindtap="onRecommend">
      {{loading ? '生成中...' : '生成搭配'}}
    </view>
  </view>

  <block wx:if="{{payload}}">
    <!-- 决策条 -->
    <view class="card">
      <view class="row">
        <text class="kv">决策</text>
        <text class="val">{{payload.decisionLabel}}</text>
      </view>
      <view class="row">
        <text class="kv">LLM 调用</text>
        <text class="val">{{payload.llm_call_count || 0}}</text>
      </view>
      <view class="row">
        <text class="kv">候选池</text>
        <text class="val">{{payload.pool.total || 0}}</text>
      </view>
    </view>

    <!-- 请求画像 -->
    <view class="card">
      <view class="section-title">🧭 请求画像</view>
      <view class="row"><text class="kv">主题</text><text class="val">{{payload.request_signature.theme}}</text></view>
      <view class="row">
        <text class="kv">情绪</text>
        <text class="val">{{payload.request_signature.unique_mood_text}}</text>
      </view>
      <view class="row">
        <text class="kv">场景</text>
        <text class="val">{{payload.request_signature.practical_context_text}}</text>
      </view>
    </view>

    <!-- 推荐方案 -->
    <view class="card" wx:for="{{payload.structured_result.recommendations}}" wx:key="outfit_id" wx:for-item="rec">
      <view class="section-title">
        方案 {{index + 1}} · {{rec.score_display}} 分
      </view>
      <view class="outfit-grid">
        <image
          wx:for="{{rec.item_ids}}"
          wx:for-item="itemId"
          wx:key="*this"
          src="{{payload.baseUrl}}/items/{{itemId}}/image"
          mode="aspectFill"
          class="outfit-img"
        />
      </view>
      <view wx:for="{{rec.reasons}}" wx:for-item="reason" wx:key="*this" class="reason">
        · {{reason}}
      </view>
    </view>

    <!-- 评审 -->
    <view class="card" wx:if="{{payload.critic}}">
      <view class="section-title">⚖️ 评审判定</view>
      <view class="row">
        <text class="kv">首选</text>
        <text class="val">{{payload.critic.outfit_assessment.outfit_id}}</text>
      </view>
      <view class="row">
        <text class="kv">理由</text>
        <text class="val">{{payload.critic.outfit_assessment.reasoning}}</text>
      </view>
    </view>
  </block>
</view>
