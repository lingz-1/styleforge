.btn-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.upload-btn,
.import-btn {
  flex: 1;
  margin-bottom: 0;
}

.import-btn {
  background: #67c23a;
}

.group-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 16rpx 0;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cell {
  width: calc(33.33% - 12rpx);
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  padding-bottom: 8rpx;
}

.cell-img {
  width: 100%;
  height: 200rpx;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}

.cell-name {
  font-size: 24rpx;
  padding: 8rpx 12rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-meta {
  font-size: 22rpx;
  color: #888;
  padding: 0 12rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
