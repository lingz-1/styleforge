.hint {
  color: #888;
  font-size: 24rpx;
  margin: 16rpx 0;
}

.stats {
  display: flex;
  justify-content: space-around;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.num {
  font-size: 40rpx;
  font-weight: 600;
}

.lbl {
  font-size: 24rpx;
  color: #888;
}

.row-item {
  display: flex;
  flex-direction: column;
}

.row-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.name {
  font-size: 26rpx;
  flex: 1;
}

.meta {
  font-size: 24rpx;
  color: #888;
  margin-left: 40rpx;
}

.gender-picker {
  padding: 16rpx 0;
  color: #409eff;
  text-align: right;
}
